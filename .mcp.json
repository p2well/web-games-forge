{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest", "--browser", "msedge"],
      "tools": [
        "browser_navigate",
        "browser_navigate_back",
        "browser_snapshot",
        "browser_click",
        "browser_hover",
        "browser_drag",
        "browser_type",
        "browser_press_key",
        "browser_select_option",
        "browser_fill_form",
        "browser_handle_dialog",
        "browser_take_screenshot",
        "browser_tabs",
        "browser_close",
        "browser_resize",
        "browser_console_messages",
        "browser_network_requests",
        "browser_network_request",
        "browser_wait_for"
      ]
    }
  }
}
